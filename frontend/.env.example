# Copy to .env.local and adjust. .env.local is git-ignored.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Where the FastAPI service lives. This is read on the SERVER only: the browser
# never calls the backend directly, it calls this app's own /api/proxy route,
# which attaches the access token. That keeps the token out of JavaScript and
# keeps the backend's address out of the client bundle.
#
#   local backend      http://127.0.0.1:8000
#   docker compose     http://api:8000
BACKEND_URL=http://127.0.0.1:8000

# How long to wait on the backend before giving up, in milliseconds.
BACKEND_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
# Set to true when serving over HTTPS. Left false for local http development,
# because a Secure cookie is never stored by the browser over plain http.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle. Never put
# a secret here.
NEXT_PUBLIC_APP_NAME=Jalachakra
